# Maintainer: Your Name <you at example dot com>
#
# 二进制包：从 GitHub Release 的 Linux 便携 tar.gz 安装。
# 发布后请用 updpkgsums 把下方 SKIP 换成真实校验和（或抄 Release 旁路的 .sha256）。
pkgname=lingchat-bin
pkgver=0.5.2
pkgrel=1
pkgdesc='AI Galgame Engine (prebuilt binary)'
arch=('x86_64' 'aarch64')
url='https://github.com/SlimeBoyOwO/LingChat'
license=('AGPL-3.0-only')
provides=('lingchat')
conflicts=('lingchat')
# 运行期依赖依据：
# - webkit2gtk-4.1 / gtk3：Tauri WebView
# - libayatana-appindicator：托盘（tray-icon → libappindicator）
# - openssl：传递依赖 native-tls / ureq（以最终二进制 NEEDED 为准，发布后可用 readelf 复核）
# - pipewire：屏幕采集 xcap → pipewire
# - vulkan-icd-loader：WebGPU/Dawn 与 GPU 枚举动态加载 libvulkan
# - hicolor-icon-theme：桌面图标主题
# 不含 alsa-lib：Cargo.lock 无 alsa/cpal 直接依赖；CI 仅作构建期开发包
depends=(
  'webkit2gtk-4.1'
  'gtk3'
  'libayatana-appindicator'
  'openssl'
  'pipewire'
  'vulkan-icd-loader'
  'hicolor-icon-theme'
)
options=('!strip' '!debug')

# tag 与 release.yml 的 tag_name 输入一致：v${pkgver}
source_x86_64=("LingChat-${pkgver}-linux-x86_64.tar.gz::${url}/releases/download/v${pkgver}/LingChat-${pkgver}-linux-x86_64.tar.gz")
source_aarch64=("LingChat-${pkgver}-linux-aarch64.tar.gz::${url}/releases/download/v${pkgver}/LingChat-${pkgver}-linux-aarch64.tar.gz")
# 发布后执行：updpkgsums
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
  local srcdir_pkg="${srcdir}/LingChat-${pkgver}-linux-${CARCH}"
  cd "${srcdir_pkg}"

  install -d "${pkgdir}/usr/lib/lingchat"

  install -Dm755 ling_chat "${pkgdir}/usr/lib/lingchat/ling_chat"

  if [[ -f libwebgpu_dawn.so ]]; then
    install -Dm755 libwebgpu_dawn.so "${pkgdir}/usr/lib/lingchat/libwebgpu_dawn.so"
  fi

  # 只读资源：不装 .portable，不把可写用户 data 打进系统目录
  install -d "${pkgdir}/usr/lib/lingchat/data"
  if [[ -d data/.official ]]; then
    cp -a data/.official "${pkgdir}/usr/lib/lingchat/data/"
  fi
  if [[ -d data/third_party ]]; then
    cp -a data/third_party "${pkgdir}/usr/lib/lingchat/data/"
  fi

  install -Dm755 /dev/stdin "${pkgdir}/usr/bin/lingchat" <<'EOF'
#!/bin/sh
exec /usr/lib/lingchat/ling_chat "$@"
EOF

  install -Dm644 /dev/stdin "${pkgdir}/usr/share/applications/lingchat.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=LingChat
Comment=AI Galgame Engine
Exec=lingchat
Icon=lingchat
Terminal=false
Categories=Game;
StartupWMClass=LingChat
EOF

  local size
  for size in 32 64 128 256; do
    if [[ -f "icons/${size}x${size}.png" ]]; then
      install -Dm644 "icons/${size}x${size}.png" \
        "${pkgdir}/usr/share/icons/hicolor/${size}x${size}/apps/lingchat.png"
    fi
  done

  if [[ -f LICENSE ]]; then
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  fi
}
