# Maintainer: FlameTN7 <FlameTN7@users.noreply.github.com>
pkgname=lingchat-bin
# 需与 src-tauri/tauri.conf.json 中的 version 保持一致
pkgver=0.5.2
pkgrel=1
pkgdesc='AI Galgame Engine'
arch=('x86_64' 'aarch64')
url='https://github.com/SlimeBoyOwO/LingChat'
license=('AGPL-3.0-only')
provides=('lingchat')
conflicts=('lingchat')
depends=(
  'gtk3'
  'webkit2gtk-4.1'
  'libayatana-appindicator'
  'openssl'
  'alsa-lib'
  'hicolor-icon-theme'
)
optdepends=(
  'pipewire: low-latency audio and screen cast support'
  'vulkan-icd-loader: Vulkan GPU tier detection and WebGPU acceleration'
  'fontconfig: system font enumeration'
  'xdg-desktop-portal: file dialogs and desktop integration'
)
options=('!strip' '!debug')

source_x86_64=("LingChat-${pkgver}-linux-x86_64.tar.gz::${url}/releases/download/v${pkgver}/LingChat-${pkgver}-linux-x86_64.tar.gz")
source_aarch64=("LingChat-${pkgver}-linux-aarch64.tar.gz::${url}/releases/download/v${pkgver}/LingChat-${pkgver}-linux-aarch64.tar.gz")
# 发布正式 Release 后替换为对应 .tar.gz.sha256 校验值
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
  local _src="$srcdir/LingChat-${pkgver}-linux-${CARCH}"
  [[ -d "$_src" ]] || {
    echo "error: 未找到解压目录 $_src" >&2
    return 1
  }

  install -Dm755 "$_src/ling_chat" "$pkgdir/usr/lib/LingChat/ling_chat"
  if [[ -f "$_src/libwebgpu_dawn.so" ]]; then
    install -Dm755 "$_src/libwebgpu_dawn.so" "$pkgdir/usr/lib/LingChat/libwebgpu_dawn.so"
  fi

  # 安装只读基准资源与第三方模型（不安装 .portable 标记，确保运行时走 XDG 用户目录）
  if [[ -d "$_src/data/.official" ]]; then
    install -d "$pkgdir/usr/lib/LingChat/data/.official"
    cp -a "$_src/data/.official/." "$pkgdir/usr/lib/LingChat/data/.official/"
  fi
  if [[ -d "$_src/data/third_party" ]]; then
    install -d "$pkgdir/usr/lib/LingChat/data/third_party"
    cp -a "$_src/data/third_party/." "$pkgdir/usr/lib/LingChat/data/third_party/"
  fi
  if [[ -d "$pkgdir/usr/lib/LingChat/data" ]]; then
    find "$pkgdir/usr/lib/LingChat/data" -type d -exec chmod 755 {} +
    find "$pkgdir/usr/lib/LingChat/data" -type f -exec chmod 644 {} +
  fi

  # 启动 wrapper
  install -d "$pkgdir/usr/bin"
  cat > "$pkgdir/usr/bin/lingchat" << 'EOF'
#!/bin/sh
exec /usr/lib/LingChat/ling_chat "$@"
EOF
  chmod 755 "$pkgdir/usr/bin/lingchat"

  # 桌面快捷方式
  install -d "$pkgdir/usr/share/applications"
  cat > "$pkgdir/usr/share/applications/lingchat.desktop" << 'EOF'
[Desktop Entry]
Type=Application
Name=LingChat
Comment=AI Galgame Engine
Exec=lingchat %U
Icon=lingchat
Terminal=false
Categories=Game;Chat;Utility;
StartupWMClass=ling_chat
EOF
  chmod 644 "$pkgdir/usr/share/applications/lingchat.desktop"

  # 多尺寸图标
  [[ -f "$_src/icons/32x32.png" ]] && install -Dm644 "$_src/icons/32x32.png" "$pkgdir/usr/share/icons/hicolor/32x32/apps/lingchat.png"
  [[ -f "$_src/icons/128x128.png" ]] && install -Dm644 "$_src/icons/128x128.png" "$pkgdir/usr/share/icons/hicolor/128x128/apps/lingchat.png"
  [[ -f "$_src/icons/128x128@2x.png" ]] && install -Dm644 "$_src/icons/128x128@2x.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/lingchat.png"
  [[ -f "$_src/icons/icon.png" ]] && install -Dm644 "$_src/icons/icon.png" "$pkgdir/usr/share/icons/hicolor/512x512/apps/lingchat.png"
}
